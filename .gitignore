cat > .gitignore << 'EOF'
# Python bytecode
__pycache__/
*.pyc

# Checkpoints / model weights
checkpoints/
*.pth
*.h5
*.npz
Janus_weights_100Epochs.zip
Janus_weights_100Epochs/
T1_T2_Flair_T1ce_nc_3_FullBrats2021_L1Tune_FFT_diffmap_RDEB_Edge_batch_24_ResVit/

# SLURM job output logs
*.out

# Result/figure images at repo root
Figure4_*.png
errormap.png
output.png
ratings_boxplot*.png
realT1ce.png

# Debug/scratch dirs
debug_features/
fomo/
old jobs/

# Large scan/data files
*.isyntax

# Ignore data/results directories
data/
results/

# OS/editor cruft
.DS_Store
EOF